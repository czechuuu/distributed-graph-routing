FROM ghcr.io/astral-sh/uv:python3.11-bookworm

WORKDIR /app

COPY serving/pyproject.toml serving/uv.lock ./
RUN uv sync --frozen --no-dev

COPY serving/shard_worker_pb2.py serving/shard_worker_pb2_grpc.py ./
COPY serving/serving ./serving

EXPOSE 50051
EXPOSE 8081

CMD ["uv", "run", "python", "-m", "serving.shard_worker"]
