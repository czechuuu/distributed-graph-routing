FROM ghcr.io/astral-sh/uv:python3.11-bookworm

WORKDIR /app

# Workspace lock + member metadata
COPY pyproject.toml uv.lock ./
COPY serving/pyproject.toml serving/pyproject.toml
COPY shared/pyproject.toml shared/pyproject.toml

# Package sources needed for editable workspace installs
COPY serving/serving serving/serving
COPY shared/shared shared/shared

RUN uv sync --frozen --no-dev --package serving

EXPOSE 8080

CMD ["uv", "run", "--package", "serving", "python", "-m", "serving.routing_api"]
